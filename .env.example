ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Market-data failover: auto = Angel One first, Upstox, then FYERS.
# Data sources are fail-closed; invalid/stale data must still be rejected by validation.
MARKET_DATA_PROVIDER=auto

UPSTOX_ENABLED=true
UPSTOX_ACCESS_TOKEN=
UPSTOX_TIMEOUT_SECONDS=8
UPSTOX_REQUEST_INTERVAL_SECONDS=1.0
# Optional JSON overrides for Upstox instrument keys.
# UPSTOX_INSTRUMENT_KEYS_JSON={"RELIANCE":"NSE_EQ|INE002A01018"}

# FYERS API v3 data-only integration. Never commit the access token.
FYERS_ENABLED=false
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=
FYERS_TIMEOUT_SECONDS=8
# Optional JSON overrides for FYERS symbols.
# FYERS_SYMBOLS_JSON={"RELIANCE":"NSE:RELIANCE-EQ","NIFTY":"NSE:NIFTY50-INDEX"}
