[Unit]
Description=PEREZ AI Trading Bot - PAPER TRADING
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/PEREZ-AI-Trading-Bot
Environment=PYTHONUNBUFFERED=1
Environment=ORDERS_ENABLED=false
Environment=PEREZ_PAPER_ONLY=true
ExecStart=/home/ubuntu/PEREZ-AI-Trading-Bot/venv/bin/python -u main.py
Restart=always
RestartSec=15
StartLimitIntervalSec=300
StartLimitBurst=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
