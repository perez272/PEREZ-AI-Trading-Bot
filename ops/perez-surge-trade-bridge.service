[Unit]
Description=PEREZ AI Fresh Surge Paper-Trade Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/PEREZ-AI-Trading-Bot
EnvironmentFile=-/home/ubuntu/PEREZ-AI-Trading-Bot/.env
EnvironmentFile=-/etc/perez-ai/upstox.env
Environment="TZ=Asia/Kolkata"
Environment="PAPER_MODE=true"
Environment="ORDERS_ENABLED=false"
Environment="UPSTOX_ENABLED=true"
Environment="MARKET_DATA_PROVIDER=upstox"
ExecStart=/home/ubuntu/PEREZ-AI-Trading-Bot/venv/bin/python -m src.surge_trade_worker
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
