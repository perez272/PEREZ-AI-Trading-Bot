# PEREZ-AI Command Center — secure reverse proxy template
# setup.sh replaces __DOMAIN__ before enabling this file.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    client_max_body_size 64k;

    # Viewer + Admin may read the Command Center.
    location / {
        auth_basic "PEREZ-AI Command Center";
        auth_basic_user_file /etc/nginx/.htpasswd-perez-ai-users;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Remote-User $remote_user;
        proxy_read_timeout 30s;
    }

    # Only the Admin credential can execute dashboard control actions.
    location = /api/action {
        auth_basic "PEREZ-AI Admin Controls";
        auth_basic_user_file /etc/nginx/.htpasswd-perez-ai-admin;
        proxy_pass http://127.0.0.1:8787/api/action;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Remote-User $remote_user;
        proxy_read_timeout 30s;
    }
}
