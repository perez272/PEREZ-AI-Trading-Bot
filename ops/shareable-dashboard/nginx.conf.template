# PEREZ-AI Command Center — secure reverse proxy template
# setup.sh replaces __DOMAIN__ before enabling this file.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Never expose the Python dashboard directly; nginx is the only public entrypoint.
    client_max_body_size 64k;

    location / {
        auth_basic "PEREZ-AI Command Center";
        auth_basic_user_file /etc/nginx/.htpasswd-perez-ai;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
