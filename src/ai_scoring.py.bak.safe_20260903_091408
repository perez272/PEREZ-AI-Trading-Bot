def calculate_score(df):
    """Return a direction-aware 0..100 market score."""
    last = df.iloc[-1]
    score = 50

    close = float(last["close"])
    ema20 = float(last["EMA20"])
    ema50 = float(last["EMA50"])
    ema200 = float(last["EMA200"])
    macd = float(last["MACD"])
    macd_signal = float(last["MACD_SIGNAL"])
    rsi = float(last["RSI"])

    bullish = close > ema20
    bearish = close < ema20

    # Price vs EMA20
    if bullish:
        score += 10
    elif bearish:
        score += 10

    # EMA20 vs EMA50
    if bullish and ema20 > ema50:
        score += 10
    elif bearish and ema20 < ema50:
        score += 10

    # EMA50 vs EMA200
    if bullish and ema50 > ema200:
        score += 10
    elif bearish and ema50 < ema200:
        score += 10

    # MACD
    if bullish and macd > macd_signal:
        score += 10
    elif bearish and macd < macd_signal:
        score += 10

    # RSI
    if bullish and rsi > 60:
        score += 10
    elif bearish and rsi < 40:
        score += 10

    # VWAP
    try:
        vwap = float(last["VWAP"])
        if vwap == vwap:
            if bullish and close > vwap:
                score += 10
            elif bearish and close < vwap:
                score += 10
    except Exception:
        pass

    return max(0, min(score, 100))
