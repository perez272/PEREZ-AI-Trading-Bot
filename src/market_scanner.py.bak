import time
from datetime import datetime, timedelta

import pyotp
from SmartApi import SmartConnect

from src.ai_scoring import calculate_score
from src.config import API_KEY, CLIENT_ID, PASSWORD, TOTP_SECRET
from src.indicators import calculate_indicators
from src.trade_decision import get_trade_decision


SYMBOLS = {
    "NIFTY": ("NSE", "99926000"),
    "BANKNIFTY": ("NSE", "99926009"),
    "RELIANCE": ("NSE", "2885"),
    "TCS": ("NSE", "11536"),
    "INFY": ("NSE", "1594"),
    "HDFCBANK": ("NSE", "1333"),
    "ICICIBANK": ("NSE", "4963"),
    "SBIN": ("NSE", "3045"),
    "AXISBANK": ("NSE", "5900"),
    "BHARTIARTL": ("NSE", "10604"),
}


def scan_market():
    obj = SmartConnect(api_key=API_KEY)
    session = obj.generateSession(
        CLIENT_ID,
        PASSWORD,
        pyotp.TOTP(TOTP_SECRET).now(),
    )

    if not session.get("status"):
        raise RuntimeError("Angel One login failed")

    results = []
    to_date = datetime.now()
    from_date = to_date - timedelta(days=5)

    for symbol, (exchange, token) in SYMBOLS.items():
        try:
            response = obj.getCandleData({
                "exchange": exchange,
                "symboltoken": token,
                "interval": "FIVE_MINUTE",
                "fromdate": from_date.strftime("%Y-%m-%d %H:%M"),
                "todate": to_date.strftime("%Y-%m-%d %H:%M"),
            })

            if not response.get("status") or not response.get("data"):
                continue

            df = calculate_indicators(response["data"])
            last = df.iloc[-1]
            score = calculate_score(df)
            signal, trend = get_trade_decision(
                score,
                float(last["RSI"]),
                float(last["EMA20"]),
                float(last["EMA50"]),
                float(last["close"]),
            )

            results.append({
                "symbol": symbol,
                "score": score,
                "close": float(last["close"]),
                "rsi": float(last["RSI"]),
                "signal": signal,
                "trend": trend,
            })
            time.sleep(1)

        except Exception as error:
            print(f"{symbol}: {error}")

    return sorted(results, key=lambda item: item["score"], reverse=True)


def select_best_candidate(results, minimum_score=80):
    eligible = [
        item for item in results
        if item["score"] >= minimum_score
        and item["signal"] in ("BUY CE", "BUY PE")
    ]
    return eligible[0] if eligible else None


def print_results(results):
    print("\nAI Ranking")
    print("-" * 60)
    for item in results:
        print(
            f"{item['symbol']:<12} "
            f"Score={item['score']}/100 "
            f"Close={item['close']:.2f} "
            f"Signal={item['signal']}"
        )
    print("-" * 60)


if __name__ == "__main__":
    print("=" * 60)
    print("PEREZ AI MARKET SCANNER")
    print("=" * 60)
    output = scan_market()
    print_results(output)
