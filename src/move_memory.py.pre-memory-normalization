"""Persistent pattern memory for large Tier-1 index option moves.

Compatibility layer for the existing Tier-1 observer database.

The physical table `move_events` is owned by tier1_option_observer.py and stores:
    threshold + move_pct + features_json

This module reads that existing schema without deleting or migrating the
historical events.
"""
from __future__ import annotations

import json
import math
import sqlite3
from pathlib import Path
from typing import Any

DB_PATH = Path("data/memory/tier1_option_moves.sqlite3")

TARGETS = (5.0, 10.0, 15.0, 20.0)

FEATURES = (
    "percent_change",
    "trend_score",
    "momentum_score",
    "vwap_score",
    "volume_score",
    "oi_score",
    "oi_change_score",
    "iv_score",
    "liquidity_score",
    "spread_pct",
    "slippage_pct",
    "atr_pct",
    "rsi",
    "rsi_slope",
    "ema_gap_pct",
    "breakout_strength",
    "body_strength",
    "volume_ratio",
    "spot_change_pct",
    "spot_score",
    "mtf_aligned",
)


def _connect() -> sqlite3.Connection:
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def _num(v: Any) -> float:
    try:
        if v is None or v == "":
            return 0.0
        return float(v)
    except (TypeError, ValueError):
        return 0.0


def _historical_features(row: sqlite3.Row) -> dict[str, Any]:
    """Decode Tier-1 raw market features without inventing score fields."""
    raw = row["features_json"]

    try:
        data = json.loads(raw) if raw else {}
    except (TypeError, ValueError, json.JSONDecodeError):
        data = {}

    if not isinstance(data, dict):
        data = {}

    mapped = dict(data)

    # The observer's raw move percentage is authoritative.
    mapped["percent_change"] = _num(
        mapped.get("percent_change", mapped.get("move_pct", row["move_pct"]))
    )

    # Do NOT map raw volume/OI/IV into score fields.
    # The live candidate and historical observer use different scales.
    # Preserve raw values so the matcher can normalize them correctly.
    for key in (
        "volume",
        "oi",
        "iv",
        "bid",
        "ask",
        "delta",
        "gamma",
        "theta",
        "vega",
    ):
        if key in mapped and mapped[key] not in (None, ""):
            mapped[key] = _num(mapped[key])

    # Preserve genuine derived fields only when they actually exist.
    for key in FEATURES:
        if key in mapped and mapped[key] not in (None, ""):
            mapped[key] = _num(mapped[key])

    return mapped


def record_move(candidate: dict[str, Any]) -> list[float]:
    """Return historical thresholds already represented by the observer.

    The Tier-1 observer owns writes to move_events. This function therefore
    does not insert a second incompatible schema into that table.
    """
    pct = _num(
        candidate.get(
            "percent_change",
            candidate.get("move_pct", candidate.get("percentChange")),
        )
    )
    if pct <= 0:
        return []
    return [target for target in TARGETS if pct >= target]


def _present(value: Any) -> bool:
    """Return True only when a feature is genuinely available."""
    if value is None or value == "":
        return False

    try:
        value = float(value)
    except (TypeError, ValueError):
        return False

    return math.isfinite(value)


def _relative_distance(a: float, b: float, scale: float) -> float:
    """Bounded relative distance for positive raw market quantities."""
    if a <= 0 or b <= 0:
        return min(abs(a - b) / max(scale, 1e-9), 3.0)

    return min(abs(math.log1p(a) - math.log1p(b)) / max(scale, 1e-9), 3.0)


def _similarity(candidate: dict[str, Any], historical: dict[str, Any]) -> float:
    """Compare only compatible, actually-present historical/live features."""
    # Raw fields are normalized independently from the gate's score fields.
    raw_scales = {
        "volume": 2.0,
        "oi": 2.0,
        "iv": 20.0,
        "delta": 0.5,
        "gamma": 0.05,
        "theta": 5.0,
        "vega": 5.0,
    }

    score_scales = {
        "percent_change": 10.0,
        "trend_score": 15.0,
        "momentum_score": 10.0,
        "vwap_score": 7.0,
        "volume_score": 8.0,
        "oi_score": 5.0,
        "oi_change_score": 8.0,
        "iv_score": 5.0,
        "liquidity_score": 7.0,
        "spread_pct": 2.0,
        "slippage_pct": 2.0,
        "atr_pct": 2.0,
        "rsi": 20.0,
        "rsi_slope": 5.0,
        "ema_gap_pct": 2.0,
        "breakout_strength": 2.0,
        "body_strength": 1.0,
        "volume_ratio": 2.0,
        "spot_change_pct": 2.0,
        "spot_score": 100.0,
        "mtf_aligned": 1.0,
    }

    raw_features = tuple(raw_scales)
    score_features = tuple(score_scales)

    distance = 0.0
    weight = 0.0

    for feature in raw_features:
        if not (_present(candidate.get(feature)) and _present(historical.get(feature))):
            continue

        a = _num(candidate.get(feature))
        b = _num(historical.get(feature))
        distance += _relative_distance(a, b, raw_scales[feature])
        weight += 1.0

    for feature in score_features:
        if not (_present(candidate.get(feature)) and _present(historical.get(feature))):
            continue

        a = _num(candidate.get(feature))
        b = _num(historical.get(feature))
        distance += min(
            abs(a - b) / max(score_scales[feature], 1e-9),
            3.0,
        )
        weight += 1.0

    # No comparable information means no similarity.
    if weight <= 0:
        return 0.0

    return max(0.0, 1.0 - distance / (weight * 1.5))

def similarity_bonus(
    candidate: dict[str, Any],
    minimum_target: float = 5.0,
) -> dict[str, Any]:
    """Return a bounded similarity bonus from unique Tier-1 historical events."""
    conn = _connect()
    rows = conn.execute(
        """
        SELECT
            id,
            symbol,
            option_type,
            expiry,
            strike,
            threshold,
            move_pct,
            features_json,
            observed_ts
        FROM move_events
        WHERE threshold >= ?
        ORDER BY id DESC
        LIMIT 5000
        """,
        (float(minimum_target),),
    ).fetchall()
    conn.close()

    if not rows:
        return {
            "bonus": 0.0,
            "matches": 0,
            "best_target": 0.0,
        }

    candidate_symbol = str(candidate.get("symbol", "")).upper()
    candidate_type = str(candidate.get("option_type", "")).upper()

    # The Tier-1 observer creates one row for each threshold reached
    # by the same observation (5%, 10%, 15%, etc.). Collapse those
    # threshold rows so one observation counts as one historical event.
    unique_events: dict[tuple[str, str, str, float, str], sqlite3.Row] = {}

    for row in rows:
        historical_symbol = str(row["symbol"] or "").upper()
        historical_type = str(row["option_type"] or "").upper()

        if candidate_symbol and historical_symbol != candidate_symbol:
            continue

        if candidate_type and historical_type and historical_type != candidate_type:
            continue

        historical = _historical_features(row)

        observation_minute = str(row["observed_ts"] or "")[:16]
        historical_instrument = str(
            historical.get("instrument_key", "")
            or historical.get("instrument", "")
        ).strip()

        event_identity = (
            historical_symbol,
            historical_type,
            historical_instrument,
            str(row["expiry"] or ""),
            _num(row["strike"]),
            observation_minute,
        )

        existing = unique_events.get(event_identity)

        # Keep the highest threshold reached by this observation.
        if existing is None or _num(row["threshold"]) > _num(existing["threshold"]):
            unique_events[event_identity] = row

    scored: list[tuple[float, float]] = []

    for row in unique_events.values():
        historical = _historical_features(row)
        score = round(_similarity(candidate, historical), 4)
        target = _num(row["threshold"])
        scored.append((score, target))

    if not scored:
        return {
            "bonus": 0.0,
            "matches": 0,
            "best_target": 0.0,
        }

    scored.sort(reverse=True)

    strong = [
        (score, target)
        for score, target in scored
        if score >= 0.45
    ]

    if not strong:
        return {
            "bonus": 0.0,
            "matches": 0,
            "best_target": 0.0,
        }

    # Only the five strongest unique historical events influence the bonus.
    best = strong[:5]
    strength = sum(score for score, _ in best) / len(best)
    bonus = min(12.0, round(strength * 12.0, 2))

    return {
        "bonus": bonus,
        "matches": len(strong),
        "best_target": max(target for _, target in strong),
    }


def memory_stats() -> dict[str, Any]:
    """Return statistics from the existing Tier-1 observer memory."""
    conn = _connect()

    total = int(
        conn.execute("SELECT COUNT(*) FROM move_events").fetchone()[0] or 0
    )

    by_target = {
        int(round(_num(threshold))): int(count)
        for threshold, count in conn.execute(
            """
            SELECT threshold, COUNT(*)
            FROM move_events
            WHERE threshold IS NOT NULL
            GROUP BY threshold
            ORDER BY threshold
            """
        )
    }

    conn.close()

    return {
        "total_events": total,
        "by_target": by_target,
        "database": str(DB_PATH),
    }
