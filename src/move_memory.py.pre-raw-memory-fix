"""Persistent pattern memory for large Tier-1 index option moves.

Compatibility layer for the existing Tier-1 observer database.

The physical table `move_events` is owned by tier1_option_observer.py and stores:
    threshold + move_pct + features_json

This module reads that existing schema without deleting or migrating the
historical events.
"""
from __future__ import annotations

import json
import math
import sqlite3
from pathlib import Path
from typing import Any

DB_PATH = Path("data/memory/tier1_option_moves.sqlite3")

TARGETS = (5.0, 10.0, 15.0, 20.0)

FEATURES = (
    "percent_change",
    "trend_score",
    "momentum_score",
    "vwap_score",
    "volume_score",
    "oi_score",
    "oi_change_score",
    "iv_score",
    "liquidity_score",
    "spread_pct",
    "slippage_pct",
    "atr_pct",
    "rsi",
    "rsi_slope",
    "ema_gap_pct",
    "breakout_strength",
    "body_strength",
    "volume_ratio",
    "spot_change_pct",
    "spot_score",
    "mtf_aligned",
)


def _connect() -> sqlite3.Connection:
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def _num(v: Any) -> float:
    try:
        if v is None or v == "":
            return 0.0
        return float(v)
    except (TypeError, ValueError):
        return 0.0


def _historical_features(row: sqlite3.Row) -> dict[str, Any]:
    """Decode the Tier-1 observer feature snapshot."""
    raw = row["features_json"]

    try:
        data = json.loads(raw) if raw else {}
    except (TypeError, ValueError, json.JSONDecodeError):
        data = {}

    if not isinstance(data, dict):
        data = {}

    # Bridge Tier-1 field names to the feature names used by this module.
    mapped = dict(data)

    mapped["percent_change"] = _num(
        mapped.get("percent_change", mapped.get("move_pct", row["move_pct"]))
    )

    mapped["iv_score"] = _num(mapped.get("iv_score", mapped.get("iv")))
    mapped["oi_score"] = _num(mapped.get("oi_score", mapped.get("oi")))
    mapped["volume_score"] = _num(
        mapped.get("volume_score", mapped.get("volume"))
    )

    return mapped


def record_move(candidate: dict[str, Any]) -> list[float]:
    """Return historical thresholds already represented by the observer.

    The Tier-1 observer owns writes to move_events. This function therefore
    does not insert a second incompatible schema into that table.
    """
    pct = _num(
        candidate.get(
            "percent_change",
            candidate.get("move_pct", candidate.get("percentChange")),
        )
    )

    if pct <= 0:
        return []

    return [target for target in TARGETS if pct >= target]


def _similarity(candidate: dict[str, Any], historical: dict[str, Any]) -> float:
    """Bounded, scale-aware similarity without future price information."""
    scales = {
        "percent_change": 10,
        "trend_score": 15,
        "momentum_score": 10,
        "vwap_score": 7,
        "volume_score": 8,
        "oi_score": 10,
        "oi_change_score": 8,
        "iv_score": 5,
        "liquidity_score": 7,
        "spread_pct": 2,
        "slippage_pct": 2,
        "atr_pct": 2,
        "rsi": 20,
        "rsi_slope": 5,
        "ema_gap_pct": 2,
        "breakout_strength": 2,
        "body_strength": 1,
        "volume_ratio": 2,
        "spot_change_pct": 2,
        "spot_score": 100,
        "mtf_aligned": 1,
    }

    distance = 0.0
    weight = 0.0

    for feature in FEATURES:
        scale = scales.get(feature, 1)
        a = _num(candidate.get(feature))
        b = _num(historical.get(feature))

        distance += min(abs(a - b) / max(scale, 1e-9), 3.0)
        weight += 1.0

    return max(0.0, 1.0 - distance / max(weight * 1.5, 1.0))


def similarity_bonus(
    candidate: dict[str, Any],
    minimum_target: float = 5.0,
) -> dict[str, Any]:
    """Return a bounded similarity bonus from unique Tier-1 historical events."""
    conn = _connect()
    rows = conn.execute(
        """
        SELECT
            id,
            symbol,
            option_type,
            expiry,
            strike,
            threshold,
            move_pct,
            features_json,
            observed_ts
        FROM move_events
        WHERE threshold >= ?
        ORDER BY id DESC
        LIMIT 5000
        """,
        (float(minimum_target),),
    ).fetchall()
    conn.close()

    if not rows:
        return {
            "bonus": 0.0,
            "matches": 0,
            "best_target": 0.0,
        }

    candidate_symbol = str(candidate.get("symbol", "")).upper()
    candidate_type = str(candidate.get("option_type", "")).upper()

    # The Tier-1 observer creates one row for each threshold reached
    # by the same observation (5%, 10%, 15%, etc.). Collapse those
    # threshold rows so one observation counts as one historical event.
    unique_events: dict[tuple[str, str, str, float, str], sqlite3.Row] = {}

    for row in rows:
        historical_symbol = str(row["symbol"] or "").upper()
        historical_type = str(row["option_type"] or "").upper()

        if candidate_symbol and historical_symbol != candidate_symbol:
            continue

        if candidate_type and historical_type and historical_type != candidate_type:
            continue

        observation_minute = str(row["observed_ts"] or "")[:16]

        event_identity = (
            historical_symbol,
            historical_type,
            str(row["expiry"] or ""),
            _num(row["strike"]),
            observation_minute,
        )

        existing = unique_events.get(event_identity)

        # Keep the highest threshold reached by this observation.
        if existing is None or _num(row["threshold"]) > _num(existing["threshold"]):
            unique_events[event_identity] = row

    scored: list[tuple[float, float]] = []

    for row in unique_events.values():
        historical = _historical_features(row)
        score = round(_similarity(candidate, historical), 4)
        target = _num(row["threshold"])
        scored.append((score, target))

    if not scored:
        return {
            "bonus": 0.0,
            "matches": 0,
            "best_target": 0.0,
        }

    scored.sort(reverse=True)

    strong = [
        (score, target)
        for score, target in scored
        if score >= 0.45
    ]

    if not strong:
        return {
            "bonus": 0.0,
            "matches": 0,
            "best_target": 0.0,
        }

    # Only the five strongest unique historical events influence the bonus.
    best = strong[:5]
    strength = sum(score for score, _ in best) / len(best)
    bonus = min(12.0, round(strength * 12.0, 2))

    return {
        "bonus": bonus,
        "matches": len(strong),
        "best_target": max(target for _, target in strong),
    }


def memory_stats() -> dict[str, Any]:
    """Return statistics from the existing Tier-1 observer memory."""
    conn = _connect()

    total = int(
        conn.execute("SELECT COUNT(*) FROM move_events").fetchone()[0] or 0
    )

    by_target = {
        int(round(_num(threshold))): int(count)
        for threshold, count in conn.execute(
            """
            SELECT threshold, COUNT(*)
            FROM move_events
            WHERE threshold IS NOT NULL
            GROUP BY threshold
            ORDER BY threshold
            """
        )
    }

    conn.close()

    return {
        "total_events": total,
        "by_target": by_target,
        "database": str(DB_PATH),
    }
